{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DF-0 executed command evidence",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "command",
    "cwd",
    "started_at",
    "elapsed_seconds",
    "exit_code",
    "outcome",
    "stdout",
    "stderr",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "compile_link_probe",
        "foundation_test",
        "installed_consumer_test",
        "binding_probe",
        "binary_inspection",
        "fixture_generation",
        "document_check",
        "resource_measurement",
        "coverage_guided_fuzz"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "build_source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        }
      }
    }
  ]
}
